# Copy to .env and fill in. Use letters and digits only in DB passwords (they go into a URL).
DB_PASSWORD=
DB_ROOT_PASSWORD=
SECRET_KEY=            # long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_EMAIL=admin@civic.local
ADMIN_PASSWORD=        # choose a strong password
WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080

# Image storage (recommended, otherwise images live on the container volume)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI: build with WITH_AI=true to include PyTorch + CLIP (about 2 GB RAM). Otherwise hash fallback is used.
WITH_AI=false
AI_ENABLED=auto
ANTHROPIC_API_KEY=     # optional, for officer summaries
